# ============================================================
# Ganado360 - Variables de entorno
# Copia este archivo como .env y configura los valores
# ============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=tu_password_mysql
DB_USERNAME=root
DB_PASSWORD=tu_password_mysql

# --- JWT (Gateway) ---
JWT_SECRET=CambiaEstaClavePorUnaSeguraDeAlMenos32Caracteres
JWT_ISSUER=my-auth-server
JWT_AUDIENCE=my-react-client

# --- Token interno Gateway → Microservicios ---
INTERNAL_GATEWAY_SECRET=CambiaPorUnSecretoInterno
GATEWAY_SECURITY_ENABLED=true

# --- Mail (servicio de usuarios) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password-de-gmail

# --- CORS (origenes permitidos para el frontend) ---
CORS_ORIGINS=http://localhost:5173

# --- URL del API para el frontend (build-time) ---
VITE_API_URL=http://localhost:8080

# --- URLs internas entre servicios (Docker Compose) ---
USERS_SERVICE_URL=http://ganadousers:8081
INVENTORY_SERVICE_URL=http://ganadoinventory:8082
SANIDAD_SERVICE_URL=http://ganadosanidad:8083
REPRODUCTION_SERVICE_URL=http://ganadoreproduccion:8084
GATEWAY_URL=http://gatewayganado:8080

# --- Hibernate ---
DDL_AUTO=update
SHOW_SQL=false

# --- Logging ---
SPRING_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
